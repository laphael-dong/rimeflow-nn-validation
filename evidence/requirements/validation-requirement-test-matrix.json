{
  "schemaVersion": 1,
  "change": "rimeflow-backend-contract",
  "repository": "github/rimeflow-nn-validation",
  "ownership": "Validation",
  "phase": "2-test-first",
  "cargoDependencyInput": {
    "manifestPath": "evidence/tooling/validation-contract/Cargo.toml",
    "lockPath": "evidence/tooling/validation-contract/Cargo.lock",
    "configPath": "evidence/tooling/validation-contract/cargo-config.toml",
    "vendorDirectory": "evidence/tooling/validation-contract/vendor",
    "policy": "all Cargo.lock registry sources are vendored with Cargo checksum metadata"
  },
  "originalBaseCommit": "eacbcf00dfc2fba941b494e2955e87fffd707382",
  "phase1DependencyCommit": "c90d3957fbbd04b3f0b29eff7bc873b70eed4400",
  "model": {
    "path": "models/yolov8n.onnx",
    "sha256": "9e7e3921595672c4b97e78f78bf5604d86ffc117773da49f142d1047109d07ad"
  },
  "fixtureCoverage": {
    "requiredScenarioIds": [
      "no-detection",
      "single-target",
      "multi-class",
      "overlap-nms",
      "extreme-aspect",
      "boundary-box"
    ],
    "webInferenceFixtureIds": [
      "no-detection",
      "single-target",
      "multi-class",
      "extreme-aspect",
      "boundary-box"
    ],
    "repeatCount": 3
  },
  "testSource": "evidence/tooling/validation-contract/src/lib.rs",
  "reportPath": "evidence/reports/validation-test-first.json",
  "requirements": [
    {
      "requirement": "Input semantics are explicit",
      "scenarios": [
        {
          "scenario": "Layout and dtype differ by artifact",
          "tests": [
            {
              "testId": "RFB-VAL-IO-001",
              "testFunction": "rfb_val_io_001_layout_and_dtype_preserve_logical_image",
              "command": "cargo test --config evidence/tooling/validation-contract/cargo-config.toml --offline --locked --manifest-path evidence/tooling/validation-contract/Cargo.toml tests::rfb_val_io_001_layout_and_dtype_preserve_logical_image -- --exact",
              "expectedFailure": {
                "classification": "target-assertion",
                "marker": "RFB-VAL-IO-001: target_assertion",
                "assertion": "同一逻辑 RGB 输入按 NCHW/NHWC 和声明 dtype 转换后保持相同语义"
              }
            }
          ]
        },
        {
          "scenario": "Input contract is unsupported",
          "tests": [
            {
              "testId": "RFB-VAL-IO-002",
              "testFunction": "rfb_val_io_002_invalid_quantization_is_rejected",
              "command": "cargo test --config evidence/tooling/validation-contract/cargo-config.toml --offline --locked --manifest-path evidence/tooling/validation-contract/Cargo.toml tests::rfb_val_io_002_invalid_quantization_is_rejected -- --exact",
              "expectedFailure": {
                "classification": "target-assertion",
                "marker": "RFB-VAL-IO-002: target_assertion",
                "assertion": "无效量化 scale 必须作为输入契约错误被拒绝"
              }
            }
          ]
        }
      ]
    },
    {
      "requirement": "Output semantics are mapped by logical role",
      "scenarios": [
        {
          "scenario": "Converted artifact renames outputs",
          "tests": [
            {
              "testId": "RFB-VAL-ROLE-001",
              "testFunction": "rfb_val_role_001_renamed_output_maps_to_detections",
              "command": "cargo test --config evidence/tooling/validation-contract/cargo-config.toml --offline --locked --manifest-path evidence/tooling/validation-contract/Cargo.toml tests::rfb_val_role_001_renamed_output_maps_to_detections -- --exact",
              "expectedFailure": {
                "classification": "target-assertion",
                "marker": "RFB-VAL-ROLE-001: target_assertion",
                "assertion": "LiteRT 重命名输出和归一化坐标必须映射回 detections role 与 ONNX 坐标语义"
              }
            }
          ]
        },
        {
          "scenario": "Output role is missing",
          "tests": [
            {
              "testId": "RFB-VAL-ROLE-002",
              "testFunction": "rfb_val_role_002_missing_output_role_is_rejected",
              "command": "cargo test --config evidence/tooling/validation-contract/cargo-config.toml --offline --locked --manifest-path evidence/tooling/validation-contract/Cargo.toml tests::rfb_val_role_002_missing_output_role_is_rejected -- --exact",
              "expectedFailure": {
                "classification": "target-assertion",
                "marker": "RFB-VAL-ROLE-002: target_assertion",
                "assertion": "缺失 detections 逻辑 role 的输出契约必须被拒绝"
              }
            }
          ]
        }
      ]
    },
    {
      "requirement": "Model conversion preserves a golden behavior baseline",
      "scenarios": [
        {
          "scenario": "Detection artifact matches baseline",
          "tests": [
            {
              "testId": "RFB-VAL-GOLDEN-001",
              "testFunction": "rfb_val_golden_001_all_raw_and_decoded_fixtures_match",
              "command": "cargo test --config evidence/tooling/validation-contract/cargo-config.toml --offline --locked --manifest-path evidence/tooling/validation-contract/Cargo.toml tests::rfb_val_golden_001_all_raw_and_decoded_fixtures_match -- --exact",
              "expectedFailure": {
                "classification": "target-assertion",
                "marker": "RFB-VAL-GOLDEN-001: target_assertion",
                "assertion": "六类 raw fixture 经逻辑 role 归一化后必须复用生产 decode/NMS 并匹配冻结结果"
              }
            }
          ]
        },
        {
          "scenario": "Conversion changes behavior beyond tolerance",
          "tests": [
            {
              "testId": "RFB-VAL-GOLDEN-002",
              "testFunction": "rfb_val_golden_002_out_of_tolerance_output_is_rejected",
              "command": "cargo test --config evidence/tooling/validation-contract/cargo-config.toml --offline --locked --manifest-path evidence/tooling/validation-contract/Cargo.toml tests::rfb_val_golden_002_out_of_tolerance_output_is_rejected -- --exact",
              "expectedFailure": {
                "classification": "target-assertion",
                "marker": "RFB-VAL-GOLDEN-002: target_assertion",
                "assertion": "超出冻结 raw tensor 容差的候选输出必须被拒绝"
              }
            }
          ]
        }
      ]
    },
    {
      "requirement": "Preprocessing and postprocessing ownership is explicit",
      "scenarios": [
        {
          "scenario": "Preprocessing remains outside the model",
          "tests": [
            {
              "testId": "RFB-VAL-POST-001",
              "testFunction": "rfb_val_post_001_preprocessing_responsibility_is_applied_once",
              "command": "cargo test --config evidence/tooling/validation-contract/cargo-config.toml --offline --locked --manifest-path evidence/tooling/validation-contract/Cargo.toml tests::rfb_val_post_001_preprocessing_responsibility_is_applied_once -- --exact",
              "expectedFailure": {
                "classification": "target-assertion",
                "marker": "RFB-VAL-POST-001: target_assertion",
                "assertion": "Core ML 已融合的 RGB/scale 与未融合的 letterbox 责任必须各执行一次"
              }
            }
          ]
        },
        {
          "scenario": "NMS is fused into one artifact",
          "tests": [
            {
              "testId": "RFB-VAL-POST-002",
              "testFunction": "rfb_val_post_002_decode_and_nms_have_one_owner",
              "command": "cargo test --config evidence/tooling/validation-contract/cargo-config.toml --offline --locked --manifest-path evidence/tooling/validation-contract/Cargo.toml tests::rfb_val_post_002_decode_and_nms_have_one_owner -- --exact",
              "expectedFailure": {
                "classification": "target-assertion",
                "marker": "RFB-VAL-POST-002: target_assertion",
                "assertion": "非融合产物只调用生产 src/postprocess.rs 一次，融合 NMS 的产物不得重复 NMS"
              }
            }
          ]
        }
      ]
    },
    {
      "requirement": "Golden fixtures and tolerances are versioned before adapter implementation",
      "scenarios": [
        {
          "scenario": "A platform artifact is compared with the baseline",
          "tests": [
            {
              "testId": "RFB-VAL-FIXTURE-001",
              "testFunction": "rfb_val_fixture_001_web_golden_covers_all_image_fixtures",
              "command": "cargo test --config evidence/tooling/validation-contract/cargo-config.toml --offline --locked --manifest-path evidence/tooling/validation-contract/Cargo.toml tests::rfb_val_fixture_001_web_golden_covers_all_image_fixtures -- --exact",
              "expectedFailure": {
                "classification": "target-assertion",
                "marker": "RFB-VAL-FIXTURE-001: target_assertion",
                "assertion": "五类真实图片 fixture 必须同时校验 role/shape、raw 摘要、decoded 结果与三次重复运行"
              }
            },
            {
              "testId": "RFB-VAL-DETERMINISM-001",
              "testFunction": "rfb_val_determinism_001_three_logical_runs_are_identical",
              "command": "cargo test --config evidence/tooling/validation-contract/cargo-config.toml --offline --locked --manifest-path evidence/tooling/validation-contract/Cargo.toml tests::rfb_val_determinism_001_three_logical_runs_are_identical -- --exact",
              "expectedFailure": {
                "classification": "target-assertion",
                "marker": "RFB-VAL-DETERMINISM-001: target_assertion",
                "assertion": "六类 fixture 的逻辑 role 归一化与生产后处理连续三次必须逐位确定"
              }
            }
          ]
        },
        {
          "scenario": "A tolerance is missing or changed after seeing a result",
          "tests": [
            {
              "testId": "RFB-VAL-FIXTURE-002",
              "testFunction": "rfb_val_fixture_002_missing_tolerance_is_rejected",
              "command": "cargo test --config evidence/tooling/validation-contract/cargo-config.toml --offline --locked --manifest-path evidence/tooling/validation-contract/Cargo.toml tests::rfb_val_fixture_002_missing_tolerance_is_rejected -- --exact",
              "expectedFailure": {
                "classification": "target-assertion",
                "marker": "RFB-VAL-FIXTURE-002: target_assertion",
                "assertion": "缺失冻结 raw 容差时 golden 验证必须失败"
              }
            }
          ]
        }
      ]
    }
  ]
}

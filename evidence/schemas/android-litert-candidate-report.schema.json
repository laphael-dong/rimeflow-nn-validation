{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rimeflow.local/schemas/android-litert-candidate-report.schema.json",
  "additionalProperties": false,
  "properties": {
    "candidateId": { "type": "string" },
    "candidateManifest": { "type": "object" },
    "hostGolden": { "type": "object" },
    "publication": {
      "additionalProperties": false,
      "properties": {
        "artifactPublished": { "const": false },
        "immutableLocation": { "type": "null" },
        "reason": { "minLength": 1, "type": "string" },
        "remoteParityVerified": { "const": false },
        "testedLocalArtifactRetained": { "const": true }
      },
      "required": ["artifactPublished", "immutableLocation", "reason", "remoteParityVerified", "testedLocalArtifactRetained"],
      "type": "object"
    },
    "schema": { "type": "object" },
    "schemaVersion": { "const": 1 },
    "sourceCheckpoint": { "type": "object" },
    "status": { "type": "object" },
    "trackedInputState": { "type": "object" }
  },
  "required": ["candidateId", "candidateManifest", "hostGolden", "publication", "schema", "schemaVersion", "sourceCheckpoint", "status", "trackedInputState"],
  "title": "Android LiteRT candidate verification report",
  "type": "object"
}

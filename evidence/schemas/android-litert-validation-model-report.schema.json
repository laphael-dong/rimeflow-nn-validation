{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Android LiteRT architecture-neutral validation model report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "deliveryContract",
    "identities",
    "validation",
    "releaseBoundary",
    "contractToEvidence",
    "replayCommands",
    "remoteParity",
    "deviationLog"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "deliveryContract": { "type": "object" },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "manifest", "schemas", "validationCommit"],
      "properties": {
        "model": { "type": "object" },
        "manifest": { "$ref": "#/$defs/fileIdentity" },
        "schemas": { "type": "object" },
        "validationCommit": { "type": "object" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rounds", "fixtureCount", "comparison", "negativeGuardCommand"],
      "properties": {
        "rounds": { "const": 2 },
        "fixtureCount": { "const": 5 },
        "comparison": { "type": "object" },
        "negativeGuardCommand": { "type": "string", "minLength": 1 }
      }
    },
    "releaseBoundary": { "type": "object" },
    "contractToEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "AC-VAL-X64-1",
        "AC-VAL-X64-2",
        "AC-VAL-X64-3",
        "AC-VAL-X64-4",
        "INV-VAL-X64-1",
        "INV-VAL-X64-2",
        "INV-VAL-X64-3",
        "EX-VAL-X64-1",
        "CON-VAL-X64-1",
        "AUTH-VAL-X64-1"
      ],
      "properties": {
        "AC-VAL-X64-1": { "$ref": "#/$defs/evidence" },
        "AC-VAL-X64-2": { "$ref": "#/$defs/evidence" },
        "AC-VAL-X64-3": { "$ref": "#/$defs/evidence" },
        "AC-VAL-X64-4": { "$ref": "#/$defs/evidence" },
        "INV-VAL-X64-1": { "$ref": "#/$defs/evidence" },
        "INV-VAL-X64-2": { "$ref": "#/$defs/evidence" },
        "INV-VAL-X64-3": { "$ref": "#/$defs/evidence" },
        "EX-VAL-X64-1": { "$ref": "#/$defs/evidence" },
        "CON-VAL-X64-1": { "$ref": "#/$defs/evidence" },
        "AUTH-VAL-X64-1": { "$ref": "#/$defs/evidence" }
      }
    },
    "replayCommands": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string", "minLength": 1 }
    },
    "remoteParity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "headCommand", "prHeadCommand", "requiredAfterSingleAuthorizedPush", "statusAtRecord"],
      "properties": {
        "branch": { "const": "rfb-android-val-x64-model-01" },
        "headCommand": { "type": "string", "minLength": 1 },
        "prHeadCommand": { "type": "string", "minLength": 1 },
        "requiredAfterSingleAuthorizedPush": { "const": true },
        "statusAtRecord": { "const": "verify-after-single-authorized-push" }
      }
    },
    "deviationLog": { "const": "none" }
  },
  "$defs": {
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "evidence"],
      "properties": {
        "outcome": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
